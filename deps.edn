{:paths ["src" "test" "resources"]
 :deps {org.clojure/clojurescript {:mvn/version "1.12.145"}
        reagent/reagent {:mvn/version "1.2.0"}
        re-frame/re-frame {:mvn/version "1.4.2"}
        metosin/jsonista {:mvn/version "1.0.1"}
        day8.re-frame/re-frame-10x {:mvn/version "1.9.3"}
        pjstadig/humane-test-output {:mvn/version "0.11.0"}
        thheller/shadow-cljs {:mvn/version "3.5.3"}
        io.github.nenadalm/clojure-utils {:git/sha "8f7dda69ef622d51c2c3a2d98d09fb201f5626ad" :git/url "https://github.com/nenadalm/clojure-tools.git"}}
 :aliases
 {:dev {:extra-paths ["dev"]}
  :cljfmt {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
           :main-opts ["-m" "cljfmt.main"]}
  :clj-kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
              :main-opts ["-m" "clj-kondo.main" "--lint" "src"]}}}
